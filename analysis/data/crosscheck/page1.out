{"post_stream":{"posts":[{"id":387033,"name":"Pete","username":"astroboysoup","avatar_template":"/user_avatar/forum.cardano.org/astroboysoup/{size}/83423_2.png","created_at":"2026-09-01T15:23:45.867Z","cooked":"\u003ch2\u003e\u003ca name=\"p-387033-come-watch-the-draper-u-genesis-pitches-1\" class=\"anchor\" href=\"#p-387033-come-watch-the-draper-u-genesis-pitches-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eCome Watch the Draper U Genesis Pitches\u003c/h2\u003e\n\u003cp\u003eOver the past couple of weeks, our Draper U Genesis cohort has been working hard on our startups, refining our business ideas, talking to potential users, testing assumptions and, most recently, preparing our pitches.\u003c/p\u003e\n\u003cp\u003eNow it’s time to put all that work on stage.\u003c/p\u003e\n\u003cp\u003eWe’ll be presenting our startups and ideas developed through the Genesis program, and I’d love to see members of the Cardano community come along and support the founders taking part.\u003c/p\u003e\n\u003cp\u003eFor many of us, this has meant late nights, constant revisions, and plenty of practice to get our pitches ready. I’ve pivoted my company 4 times since joining the program.\u003c/p\u003e\n\u003cp\u003eIf you’re interested in what’s being built, the founders coming through the program, or simply want to support people building within the Cardano ecosystem, come and watch.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"https://emoji.discourse-cdn.com/apple/backhand_index_pointing_right.png?v=15\" title=\":backhand_index_pointing_right:\" class=\"emoji\" alt=\":backhand_index_pointing_right:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e \u003cstrong\u003eWatch the Draper U Genesis pitches here:\u003c/strong\u003e\u003cbr\u003e\n\u003ca href=\"https://link.learncardano.io/genesis-day\"\u003ehttps://link.learncardano.io/genesis-day\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eHope to see plenty of familiar Cardano faces there.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":1,"updated_at":"2026-09-01T15:24:39.323Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":8,"reads":4,"readers_count":3,"score":40.8,"yours":false,"topic_id":156577,"topic_slug":"come-watch-the-pitches-from-draper-university-genesis-program-demo-day","display_username":"Pete","primary_group_name":"Ambassadors","flair_name":"Ambassadors","flair_url":"https://us1.discourse-cdn.com/flex023/uploads/cardano/original/2X/e/e6e2f6dcda6b2d5510874397b1e160c43192c017.png","flair_bg_color":"ffffff","flair_color":"","flair_group_id":44,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://link.learncardano.io/genesis-day","internal":false,"reflection":false,"title":"Genesis Pre-Accelerator Demo Day · Luma","clicks":2}],"read":true,"user_title":"Ambassador","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":17673,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/come-watch-the-pitches-from-draper-university-genesis-program-demo-day/156577/1","calendar_details":[],"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false}],"stream":[387033]},"timeline_lookup":[[1,15]],"suggested_topics":[],"tags":[{"id":1150,"name":"draper","slug":"draper"}],"tags_descriptions":{},"fancy_title":"Come Watch the Pitches from Draper University Genesis Program Demo Day","id":156577,"title":"Come Watch the Pitches from Draper University Genesis Program Demo Day","posts_count":1,"created_at":"2026-09-01T15:23:45.715Z","views":31,"reply_count":0,"like_count":0,"last_posted_at":"2026-09-01T15:23:45.867Z","visible":true,"closed":false,"archived":false,"has_summary":false,"archetype":"regular","slug":"come-watch-the-pitches-from