{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doc page frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "audience",
    "status",
    "last_reviewed",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "category": {
      "enum": [
        "overview",
        "verification",
        "methodology",
        "governance",
        "statutory",
        "operations",
        "reference"
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "regulator",
          "builder",
          "community",
          "journalist",
          "academic",
          "skeptic"
        ]
      }
    },
    "status": {
      "enum": [
        "locked",
        "draft"
      ]
    },
    "publish": {
      "type": "boolean",
      "default": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "methodology_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 12,
      "maxLength": 240
    }
  }
}