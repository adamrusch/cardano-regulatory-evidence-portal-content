{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAQ entry frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "audience",
    "category",
    "status",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 8
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "regulator",
          "builder",
          "community",
          "journalist",
          "academic",
          "skeptic"
        ]
      }
    },
    "category": {
      "enum": [
        "about",
        "site-tour",
        "metrics",
        "sources",
        "anchoring",
        "methodology",
        "governance",
        "statutory",
        "recognition-ledger",
        "concepts",
        "contributing",
        "consumption"
      ]
    },
    "status": {
      "enum": [
        "locked",
        "draft"
      ]
    },
    "publish": {
      "type": "boolean",
      "default": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "methodology_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_bound": {
      "type": "boolean",
      "default": false,
      "description": "True when the entry's truth depends on the current deployment era (draft host, anchoring not begun, governance bodies not yet seated). The set of flagged entries is the review checklist for the production reset."
    }
  }
}